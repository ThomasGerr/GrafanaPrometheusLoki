# ─────────────────────────────────────────────────────────────
# grafana-prometheus-loki — copy to .env locally, or paste into
# Dokploy → your compose service → Environment tab.
# ─────────────────────────────────────────────────────────────

# Public hostnames (used for links inside alert emails and Grafana)
GRAFANA_ROOT_URL=https://monitor.example.com
INGEST_PUBLIC_URL=https://ingest.example.com

# ── Grafana admin ────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random

# Shared secret between Grafana and the on-demand image renderer (`make render`).
# Grafana will not start without it. Generate with: openssl rand -hex 24
RENDERER_TOKEN=change-me

# ── Ingest gateway credentials ───────────────────────────────
# Comma-separated "clientid:password" pairs. The client id MUST match
# the `id:` in clients.yml — it becomes the Loki tenant for that agent.
# Generate passwords with: openssl rand -base64 24
INGEST_USERS=acme:CHANGEME,globex:CHANGEME

# ── SMTP for Alertmanager ────────────────────────────────────
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=monitoring@example.com
SMTP_USER=monitoring@example.com
SMTP_PASSWORD=change-me
SMTP_REQUIRE_TLS=true

# Your own address — receives a copy of every alert from every client
OPS_EMAIL=ops@example.com

# ── Optional: published port overrides (LOCAL DEVELOPMENT ONLY) ──────────────
# These apply to docker-compose.dev.yml, which `make up` uses. All of its
# ports bind to 127.0.0.1; override one if it is already in use on your
# machine. The Dokploy stack (docker-compose.yml) publishes no ports and
# ignores these entirely — route Grafana and ingest via the Domains tab.
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# LOKI_PORT=3100
# INGEST_PORT=8080
