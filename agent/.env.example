# Agent settings. Copy to .env next to docker-compose.yml (or paste into
# Dokploy's Environment tab), fill in, then: docker compose up -d --build
# install.sh writes this file for you if you prefer. See docs/agent.md.
#
# Put a value in single quotes when it contains $, a space or #:
#   INGEST_PASSWORD='pa$$word'

# ── Required ─────────────────────────────────────────────────────────────────
# Must exactly match the client `id` in the central clients.yml.
CLIENT_ID=acme

# How this server appears in dashboards and alert emails. Make it recognisable:
# "acme-web-01" beats "ip-172-31-4-9".
HOST_NAME=acme-web-01

# Central ingest gateway. No trailing slash.
INGEST_URL=https://ingest.example.com

# The password for this client from the central INGEST_USERS variable.
INGEST_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the host keeps its systemd journal, if not /var/log/journal.
#JOURNAL_DIR=/run/log/journal

# Databases to monitor, one variable each: DB_<NAME>=<url>. For a database
# in another container, also name the Docker network it is on (Dokploy's
# databases are on dokploy-network). See docs/databases.md.
#DB_APP=postgres://monitor:password@app-db:5432/app
#DB_CACHE=redis://:password@cache:6379
#AGENT_DB_NETWORK=dokploy-network

# CrowdSec: detects attacks and blocks them in this host's firewall.
# See docs/crowdsec.md.
#COMPOSE_PROFILES=crowdsec
#CROWDSEC_BOUNCER_KEY=        # required with CrowdSec: openssl rand -hex 32
#CROWDSEC_WHITELIST=203.0.113.7,198.51.100.0/24
#CROWDSEC_ENROLL_KEY=
#CROWDSEC_TRAEFIK_DIR=/etc/dokploy/traefik/dynamic   # on a Dokploy host
