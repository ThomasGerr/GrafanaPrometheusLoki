# Agent settings. Copy to .env next to docker-compose.yml (or paste into
# Dokploy's Environment tab), fill in, then: docker compose up -d --build
# install.sh writes this file for you if you prefer. See docs/agent.md.
#
# Put a value in single quotes when it contains $, a space or #:
#   INGEST_PASSWORD='pa$$word'

# ── Required ─────────────────────────────────────────────────────────────────
# Must exactly match the client `id` in the central clients.yml.
CLIENT_ID=acme

# How this server appears in dashboards and alert emails. Make it recognisable:
# "acme-web-01" beats "ip-172-31-4-9".
HOST_NAME=acme-web-01

# Central ingest gateway. No trailing slash.
INGEST_URL=https://ingest.example.com

# The password for this client from the central INGEST_USERS variable.
INGEST_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the host keeps its systemd journal, if not /var/log/journal.
#JOURNAL_DIR=/run/log/journal

# Databases to monitor, one variable each: DB_<NAME>=<url>. For a database
# in another container, also name the Docker network it is on (Dokploy's
# databases are on dokploy-network). See docs/databases.md.
#DB_APP=postgres://monitor:password@app-db:5432/app
#DB_CACHE=redis://:password@cache:6379
#AGENT_DB_NETWORK=dokploy-network

# CrowdSec: detects attacks and blocks them in this host's firewall.
# See docs/crowdsec.md.
#COMPOSE_PROFILES=crowdsec
#CROWDSEC_BOUNCER_KEY=        # required with CrowdSec: openssl rand -hex 32
#CROWDSEC_WHITELIST=203.0.113.7,198.51.100.0/24
#CROWDSEC_ENROLL_KEY=
#CROWDSEC_TRAEFIK_DIR=/etc/dokploy/traefik/dynamic   # on a Dokploy host

# Backups with restic: host paths, Docker volumes and a dump of every DB_
# database. Add backup to COMPOSE_PROFILES (crowdsec,backup for both).
# See docs/backups.md. Keep RESTIC_PASSWORD somewhere other than this server.
#COMPOSE_PROFILES=backup
#RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/bucket/this-host
#RESTIC_PASSWORD=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#BACKUP_PATHS=/etc,/opt
#BACKUP_DOCKER_VOLUMES=true
#BACKUP_DB_APP=postgres://backup:password@app-db:5432/app   # a user that may read the data
#BACKUP_SCHEDULE=0 3 * * *   # only used until a schedule is added from the dashboard

# Processes are grouped by the name of their program, which is all the kernel
# offers: every pm2-managed app is "node", every Python service "python3", and
# the name stops at 15 characters. Name a group yourself by matching the
# command line instead — these are tried first, in the order given.
#PROCESS_GROUP_API=node .*/api/server\.js
#PROCESS_GROUP_WORKER=node .*/worker\.js

# Log files to read, for programs that write their own rather than logging to
# the journal or from a container (pm2, anything started from rc.local). The
# lines arrive labelled program=<name>, filename=<path on this host>.
#LOG_FILE_PM2=/home/deploy/.pm2/logs/*.log
#LOG_FILE_NGINX=/var/log/nginx/*.log

# Where this host keeps containerd's socket. Only set it if it is not in the
# usual place; without it, container metrics are missing on hosts using the
# systemd cgroup driver.
#CONTAINERD_DIR=/var/snap/docker/current/run/containerd

# Schedules and restores are managed from the Backups dashboard, and this
# agent asks for its own through the ingest gateway with INGEST_PASSWORD
# above — the dashboard's BACKUP_API_TOKEN belongs to the monitoring stack
# and is never needed here. How often to ask:
#BACKUP_POLL_SECONDS=30
