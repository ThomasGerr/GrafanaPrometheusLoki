// ═══════════════════════════════════════════════════════════════════════════
// grafana-prometheus-loki agent
//
// One container per monitored host. It collects host metrics, container
// metrics, container logs and system logs, then pushes everything outbound
// to the central stack over HTTPS. Nothing listens on a public port.
//
// Configured entirely through environment variables — see .env. Database
// monitoring lives next to this file in databases.alloy and connections.alloy.
// ═══════════════════════════════════════════════════════════════════════════

logging {
  level  = "info"
  format = "logfmt"
}

// ───────────────────────────────────────────────────────────────────────────
// METRICS
// ───────────────────────────────────────────────────────────────────────────

// Host metrics. Paths point at the read-only host mounts declared in
// docker-compose.yml, so this reports the real machine rather than the
// container's own namespaced view of it.
prometheus.exporter.unix "host" {
  rootfs_path = "/rootfs"
  procfs_path = "/rootfs/proc"
  sysfs_path  = "/rootfs/sys"

  // Only the collectors something reads. The default set also runs NFS,
  // ARP, conntrack, softnet and a dozen more, whose ~1,900 series per host
  // no rule or panel uses — each one costs scrape time here and 30 days of
  // storage centrally. Add a collector here, and its metrics to
  // prometheus.relabel "keep" below, before querying anything new.
  set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev", "processes", "stat", "time", "timex", "textfile"]

  // The backup service's results (restic_*), when backups are on.
  textfile {
    directory = "/var/lib/node-textfile"
  }

  filesystem {
    // Docker's overlay mounts would otherwise appear as hundreds of
    // near-identical filesystems and swamp the disk panels.
    mount_points_exclude = "^/(dev|proc|sys|run|var/lib/docker/.+|var/lib/containerd/.+)($|/)"
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_timeout        = "5s"
  }

  netdev {
    device_exclude = "^(veth.*|docker[0-9]+|br-.*|lo)$"
  }
}

// Container metrics via the built-in cAdvisor. Using Alloy's own exporter
// keeps the agent to a single container instead of three.
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  // cAdvisor's own in-memory history. Prometheus computes the rates, so the
  // default two minutes (four scrapes) is plenty.
  storage_duration = "2m"

  // By default every Docker label becomes a container_label_* label on every
  // series. On a Dokploy host that is ~20 Traefik and Compose labels, up to
  // 2 KB, sent with every sample — and a redeploy that changes one starts a
  // whole new set of series. Nothing queries them; name, image and id stay.
  store_container_labels = false

  // An allowlist, not a denylist. `disabled_metrics` looks like the natural
  // choice here but panics Alloy v1.19.0 at startup on any value (nil deref
  // inside the vendored cAdvisor manager), so the allowlist is the working
  // form. It also keeps cardinality down, which is the point: the default set
  // includes per-CPU and per-process series that nothing here queries.
  //
  // No "disk" or "diskIO": nothing queries per-container filesystem metrics,
  // and collecting them makes cAdvisor walk every container's filesystem,
  // which on a host with large images is real disk I/O for nothing.
  enabled_metrics = ["cpu", "memory", "network", "oom_event"]
}

// Host processes are collected too. The exporter itself is generated at
// start-up into processes.alloy, because PROCESS_GROUP_* variables can name
// groups of processes and only the host knows what runs on it.

// Alloy's own health. Only `up` and the version leave the host (see
// prometheus.relabel "keep"); the rest is there for the local UI.
prometheus.exporter.self "agent" {}

// Stamp the host identity onto every target. Without this the `instance`
// label would be the exporter's loopback address, which is meaningless
// once metrics from twenty hosts land in one Prometheus.
discovery.relabel "host_metrics" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_NAME")
  }
  // Alloy's built-in exporters ship a `job` label of their own
  // ("integrations/unix"), and a target label beats prometheus.scrape's
  // job_name. Set it here or the central alert rules, which match
  // job="node", never fire.
  rule {
    target_label = "job"
    replacement  = "node"
  }
}

discovery.relabel "process_metrics" {
  targets = prometheus.exporter.process.processes.targets
  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_NAME")
  }
  rule {
    target_label = "job"
    replacement  = "process"
  }
}

discovery.relabel "container_metrics" {
  targets = prometheus.exporter.cadvisor.containers.targets
  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_NAME")
  }
  rule {
    target_label = "job"
    replacement  = "cadvisor"
  }
}

discovery.relabel "agent_metrics" {
  targets = prometheus.exporter.self.agent.targets
  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_NAME")
  }
  rule {
    target_label = "job"
    replacement  = "alloy"
  }
}

// The job names here are what the central alert rules match on
// ("node", "cadvisor") — do not rename them without updating the rules.
prometheus.scrape "host" {
  targets         = discovery.relabel.host_metrics.output
  forward_to      = [prometheus.relabel.keep.receiver]
  job_name        = "node"
  scrape_interval = "30s"
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.container_metrics.output
  forward_to      = [prometheus.relabel.keep.receiver]
  job_name        = "cadvisor"
  scrape_interval = "30s"
}

prometheus.scrape "processes" {
  targets         = discovery.relabel.process_metrics.output
  forward_to      = [prometheus.relabel.keep.receiver]
  job_name        = "process"
  // Half as often as the host itself: walking /proc costs more than reading
  // a handful of counters, and which program is busy does not change from
  // one half-minute to the next.
  scrape_interval = "60s"
}

prometheus.scrape "agent" {
  targets         = discovery.relabel.agent_metrics.output
  forward_to      = [prometheus.relabel.keep.receiver]
  job_name        = "alloy"
  scrape_interval = "60s"
}

// Only metrics that a central rule or dashboard uses leave the host. The
// exporters above still produce far more than that (cAdvisor's per-interface
// packet and error counters alone are ~2,000 series on a busy host), and
// unfiltered this agent sent ~6,400 series and ~1.2 GB a day, 87% of it
// never read. `up` is the synthetic scrape-health series HostExporterFailing
// needs. Database metrics bypass this: each database component in
// databases.alloy keeps its own allowlist.
//
// Using a new metric in a rule or panel means adding it here first;
// scripts/check-metric-allowlist.py (part of `make validate`) fails until
// you do.
prometheus.relabel "keep" {
  forward_to = [prometheus.remote_write.central.receiver]

  // Every process reports resident, virtual and swapped memory. Virtual is
  // address space rather than memory in use, and nothing here asks about it.
  rule {
    source_labels = ["__name__", "memtype"]
    regex         = "namedprocess_namegroup_memory_bytes;virtual"
    action        = "drop"
  }

  rule {
    source_labels = ["__name__"]
    regex         = "up|alloy_build_info|node_(boot_time_seconds|cpu_seconds_total|disk_(read|written)_bytes_total|filesystem_(avail_bytes|files|files_free|readonly|size_bytes)|load1|load5|load15|memory_(Buffers|Cached|MemAvailable|MemTotal|SwapFree|SwapTotal)_bytes|network_(receive|transmit)_bytes_total|processes_(max_processes|pids)|time_seconds|timex_offset_seconds)|namedprocess_namegroup_(cpu_seconds_total|memory_bytes|num_procs|num_threads|open_filedesc)|restic_[a-z_]+|container_(cpu_usage_seconds_total|last_seen|memory_working_set_bytes|network_(receive|transmit)_bytes_total|oom_events_total|spec_memory_limit_bytes|start_time_seconds)"
    action        = "keep"
  }
}

prometheus.remote_write "central" {
  // The tenant label. Every metric this agent sends is tagged with it, and
  // the central label proxy uses it to decide who may see this data.
  external_labels = {
    client = sys.env("CLIENT_ID"),
  }

  endpoint {
    url = sys.env("INGEST_URL") + "/api/v1/write"

    basic_auth {
      username = sys.env("CLIENT_ID")
      password = sys.env("INGEST_PASSWORD")
    }

    // Survive a central-stack restart or a short network outage without
    // losing data: samples buffer on disk and replay when the link returns.
    queue_config {
      capacity             = 10000
      max_shards           = 10
      min_shards           = 1
      max_samples_per_send = 2000
      batch_send_deadline  = "5s"
      retry_on_http_429    = true
    }
  }

  // Two hours of buffering is enough for a maintenance window.
  wal {
    truncate_frequency = "2h"
    max_keepalive_time = "8h"
  }
}

// ───────────────────────────────────────────────────────────────────────────
// LOGS
// ───────────────────────────────────────────────────────────────────────────

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

// Docker reports container names with a leading slash; strip it so the label
// matches what `docker ps` shows and what the metrics use.
discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  // Compose project, when there is one — handy for grouping in the UI.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  relabel_rules    = discovery.relabel.container_logs.rules
  forward_to       = [loki.process.enrich.receiver]
  refresh_interval = "15s"

  labels = {
    client   = sys.env("CLIENT_ID"),
    instance = sys.env("HOST_NAME"),
    job      = "docker",
  }
}

// System logs: sshd, kernel, systemd units, unattended-upgrades.
discovery.relabel "journal_logs" {
  targets = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // The program that wrote the line (sshd, sudo, useradd, ...). sudo and the
  // account tools run outside any systemd unit, so without this they cannot
  // be told apart. The security alerts in config/loki/security.rules.yml
  // depend on it. The set of programs on a host is small, so it is a safe
  // label.
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "program"
  }

  // loki.source.journal overwrites the `job` from its `labels` block with
  // its own component name ("loki.source.journal.system"). Relabelling runs
  // afterwards, so set it here; the security alerts select on job="systemd".
  rule {
    target_label = "job"
    replacement  = "systemd"
  }
}

// install.sh mounts the host's journal here, wherever the host keeps it
// (/var/log/journal when stored on disk, /run/log/journal when in memory).
loki.source.journal "system" {
  path          = "/var/log/journal"
  max_age       = "12h"
  relabel_rules = discovery.relabel.journal_logs.rules
  forward_to    = [loki.process.enrich.receiver]

  labels = {
    client   = sys.env("CLIENT_ID"),
    instance = sys.env("HOST_NAME"),
    job      = "systemd",
  }
}

loki.process "enrich" {
  forward_to = [loki.write.central.receiver]

  // On a fresh install there is no read position yet, so loki.source.docker
  // starts at the beginning of every container's log — a container that has
  // been up since May replays months of history. Loki refuses anything older
  // than reject_old_samples_max_age (168h in config/loki/loki.yml) and fails
  // the push with a 400, so the agent discards the whole batch, current lines
  // included. Drop the backlog here instead, before it is ever batched.
  //
  // 167h rather than 168h: the entry is timestamped at read time but judged
  // at arrival, and a batch sitting in the queue during a retry must not age
  // past the limit in flight.
  stage.drop {
    older_than          = "167h"
    drop_counter_reason = "older_than_loki_window"
  }

  // prometheus.exporter.mongodb on MongoDB 8 collects the opLatencies
  // histograms twice and logs 64 errors per scrape saying so — about 180,000
  // lines a day per database, in the agent's own log, which the client can
  // read. The metrics themselves still arrive. Drop exactly this message.
  stage.drop {
    expression          = "mongodb_ss_opLatencies_.*was collected before with the same name and label values"
    drop_counter_reason = "mongodb_exporter_duplicate_metric"
  }

  // Health-check chatter is the single largest source of useless log volume
  // on a Dokploy host. Dropping it here saves storage and makes searching
  // the remaining lines worthwhile.
  stage.drop {
    expression = "(?i)(GET|HEAD) /(health|healthz|ping|-/healthy|-/ready)"
    drop_counter_reason = "healthcheck_noise"
  }

  // Cap absurd single lines (stack traces of embedded blobs) rather than
  // letting one process blow through the tenant's ingest limit.
  stage.match {
    selector = "{job=\"docker\"}"
    stage.limit {
      rate  = 500
      burst = 1000
      drop  = true
    }
  }
}

loki.write "central" {
  endpoint {
    url = sys.env("INGEST_URL") + "/loki/api/v1/push"

    basic_auth {
      username = sys.env("CLIENT_ID")
      password = sys.env("INGEST_PASSWORD")
    }
  }

  // No tenant_id here on purpose. The ingest gateway sets X-Scope-OrgID from
  // the authenticated username, so the tenant cannot be forged from this side.
}
