      }
    },
    {
      "type": "logs",
      "title": "Account and group changes",
      "description": "Users and groups created, changed or removed, and password changes.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"useradd|usermod|userdel|groupadd|groupdel|gpasswd|passwd|chpasswd\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
