{
  "uid": "em-security",
  "title": "Security",
  "description": "SSH logins, sudo use and account changes from each host's system logs. Counts cover the selected time range.",
  "tags": [
    "grafana-prometheus-loki"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "client",
          "stream": "{job=\"systemd\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Host",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "instance",
          "stream": "{client=\"$client\", job=\"systemd\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Failed SSH logins",
      "description": "Failed SSH login attempts in the selected time range. On a server that is open to the internet, a steady number here is normal.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey)|Invalid user|Connection closed by (authenticating|invalid) user|maximum authentication attempts\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "stat",
      "title": "Addresses trying to log in",
      "description": "Distinct IP addresses with failed SSH logins in the selected time range.",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(sum by (ip) (count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey)|Invalid user|Connection closed by (authenticating|invalid) user|maximum authentication attempts\" | regexp \"(?P<ip>[0-9]{1,3}(\\\\.[0-9]{1,3}){3}|[0-9a-fA-F]*:[0-9a-fA-F:]+) port\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Banned now",
      "description": "Of the addresses that failed to log in over SSH in the time range, how many CrowdSec on that host has banned in the last 4 hours, so they are blocked right now. Empty on hosts without CrowdSec.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "instant",
          "expr": "count((sum by (instance, ip) (count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey)|Invalid user|Connection closed by (authenticating|invalid) user|maximum authentication attempts\" | regexp \"(?P<ip>[0-9]{1,3}(\\\\.[0-9]{1,3}){3}|[0-9a-fA-F]*:[0-9a-fA-F:]+) port\" [$__range]))) and on (instance, ip) (sum by (instance, ip) (count_over_time({client=\"$client\", instance=~\"$instance\", container=\"grafana-prometheus-loki-crowdsec\"} |= \" ban on Ip \" | regexp `by ip (?P<ip>[0-9a-fA-F.:]+) : \\S+ ban on` [4h]))))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Successful SSH logins",
      "description": "Every successful SSH login in the selected time range. Each one should be someone you know.",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |= \"Accepted \" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "stat",
      "title": "Failed sudo attempts",
      "description": "Wrong sudo passwords, or accounts that are not allowed to use sudo.",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=\"sudo\"} |~ \"incorrect password attempts|NOT in sudoers|authentication failure\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "timeseries",
      "title": "SSH logins over time",
      "description": "Failed attempts against successful logins. A successful login right after a spike of failures is worth a closer look.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey)|Invalid user|Connection closed by (authenticating|invalid) user|maximum authentication attempts\" [$__interval]))",
          "refId": "A",
          "legendFormat": "Failed",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |= \"Accepted \" [$__interval]))",
          "refId": "B",
          "legendFormat": "Successful",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Successful"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "table",
      "title": "Top addresses with failed logins",
      "description": "The addresses with the most failed SSH logins in the time range, and whether CrowdSec on that host has banned them. Banned: a ban in the last 4 hours, CrowdSec's default ban length, so it is still in force. Expired: banned earlier in the range; the ban has run out, and a new attempt starts over. Empty: not banned, or CrowdSec is not turned on for that host.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(15, sum by (instance, ip) (count_over_time({client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey)|Invalid user|Connection closed by (authenticating|invalid) user|maximum authentication attempts\" | regexp \"(?P<ip>[0-9]{1,3}(\\\\.[0-9]{1,3}){3}|[0-9a-fA-F]*:[0-9a-fA-F:]+) port\" [$__range])))"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",
          "queryType": "instant",
          "expr": "(((sum by (instance, ip) (count_over_time({client=\"$client\", instance=~\"$instance\", container=\"grafana-prometheus-loki-crowdsec\"} |= \" ban on Ip \" | regexp `by ip (?P<ip>[0-9a-fA-F.:]+) : \\S+ ban on` [4h]))) > 0) * 0 + 2) or (((sum by (instance, ip) (count_over_time({client=\"$client\", instance=~\"$instance\", container=\"grafana-prometheus-loki-crowdsec\"} |= \" ban on Ip \" | regexp `by ip (?P<ip>[0-9a-fA-F.:]+) : \\S+ ban on` [$__range]))) > 0) * 0 + 1)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "Value #A",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "ip": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "instance": "Host",
              "ip": "Address",
              "Value #A": "Attempts",
              "Value #B": "CrowdSec"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Attempts",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CrowdSec"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "2": {
                        "text": "Banned",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Expired",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "noValue",
                "value": "–"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "transparent"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attempts"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
