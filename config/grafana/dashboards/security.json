        "uid": "loki"
      }
    },
    {
      "type": "logs",
      "title": "Failed SSH logins",
      "description": "The raw failed attempts, newest first.",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{client=\"$client\", instance=~\"$instance\", job=\"systemd\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey)|Invalid user|Connection closed by (authenticating|invalid) user|maximum authentication attempts\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
