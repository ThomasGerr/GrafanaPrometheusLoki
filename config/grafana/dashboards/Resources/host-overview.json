        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_SwapTotal_bytes{client=~\"$client\", instance=~\"$instance\"} - node_memory_SwapFree_bytes{client=~\"$client\", instance=~\"$instance\"}",
