    {
      "id": 9,
      "type": "timeseries",
      "title": "Load average (per core)",
      "description": "Normalised by core count: 1.0 means fully busy, above 2.0 means queueing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load1{client=~\"$client\", instance=~\"$instance\"} / on (client, instance) group_left count by (client, instance) (node_cpu_seconds_total{mode=\"idle\", client=~\"$client\", instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{instance}} 1m"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load15{client=~\"$client\", instance=~\"$instance\"} / on (client, instance) group_left count by (client, instance) (node_cpu_seconds_total{mode=\"idle\", client=~\"$client\", instance=~\"$instance\"})",
          "refId": "B",
          "legendFormat": "{{instance}} 15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
