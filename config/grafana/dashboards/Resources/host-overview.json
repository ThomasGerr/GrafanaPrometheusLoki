          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{client=~\"$client\", instance=~\"$instance\"} - node_memory_MemAvailable_bytes{client=~\"$client\", instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}} used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_Cached_bytes{client=~\"$client\", instance=~\"$instance\"} + node_memory_Buffers_bytes{client=~\"$client\", instance=~\"$instance\"}",
