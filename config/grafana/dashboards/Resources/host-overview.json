          },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", client=~\"$client\", instance=~\"$instance\"}[5m])) * 100)",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
