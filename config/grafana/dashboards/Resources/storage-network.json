          "expr": "topk(15, sum by (device, instance) (rate(node_disk_read_bytes_total{device!~\"loop.*|dm-.*\", client=~\"$client\", instance=~\"$instance\"}[5m]) + rate(node_disk_written_bytes_total{device!~\"loop.*|dm-.*\", client=~\"$client\", instance=~\"$instance\"}[5m])))",
