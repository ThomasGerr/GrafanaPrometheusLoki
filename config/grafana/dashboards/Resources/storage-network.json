      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            },
            "renameByName": {
              "device": "Disk",
              "instance": "Host",
              "Value": "Throughput"
            },
            "indexByName": {
              "device": 0,
              "instance": 1,
              "Value": 2
            }
          }
        }
      ]
    },
