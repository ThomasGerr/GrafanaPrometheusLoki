      "id": 15,
      "type": "timeseries",
      "title": "Longest open transaction",
      "description": "Postgres. An hour or more raises DatabaseLongTransaction: it holds locks and blocks vacuum.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (db, instance) (pg_stat_activity_max_tx_duration{state=~\"active|idle in transaction.*\", client=~\"$client\", instance=~\"$instance\", db=~\"$db\"})",
          "refId": "A",
          "legendFormat": "{{db}} ({{instance}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Replication lag",
      "description": "Replicas only, Postgres and MySQL. Empty when no monitored database is a replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (db, instance) (pg_replication_lag_seconds{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"}) and on (db, instance) max by (db, instance) (pg_replication_is_replica{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"}) == 1",
          "refId": "A",
          "legendFormat": "{{db}} ({{instance}})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (db, instance) (mysql_slave_status_seconds_behind_master{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"})",
          "refId": "B",
          "legendFormat": "{{db}} ({{instance}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Redis memory vs maxmemory",
      "description": "Only Redis instances with a maxmemory limit. Past 100% Redis evicts keys or refuses writes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (db, instance) (redis_memory_used_bytes{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"}) / (max by (db, instance) (redis_memory_max_bytes{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"}) > 0) * 100",
          "refId": "A",
          "legendFormat": "{{db}} ({{instance}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "gradientMode": "opacity"
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "MySQL slow queries",
      "description": "Queries slower than long_query_time (10 s by default) per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db, instance) (rate(mysql_global_status_slow_queries{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{db}} ({{instance}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
