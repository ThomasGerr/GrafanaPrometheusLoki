            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client, instance, job, db) (database:operations:rate5m{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
