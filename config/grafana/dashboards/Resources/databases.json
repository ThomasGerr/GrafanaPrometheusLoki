        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client, instance, job, db) (database:up{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "database:connections{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"} / database:connections_max{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"} * 100",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (client, instance, job, db) (database:connections{client=~\"$client\", instance=~\"$instance\", db=~\"$db\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
