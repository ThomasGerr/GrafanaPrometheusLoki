    {
      "id": 7,
      "type": "table",
      "title": "Databases",
      "description": "One row per monitored connection. Engine-specific measures: operations are transactions (Postgres), statements (MySQL), commands (Redis), operations (MongoDB) or batches (MSSQL).",
