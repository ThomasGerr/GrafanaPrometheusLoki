{
  "uid": "em-logs",
  "title": "Logs",
  "description": "Container and system logs from every monitored host: where the errors come from, and the lines themselves, newest first.",
  "tags": [
    "grafana-prometheus-loki"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client",
        "description": "Your Org only ever shows your own environment.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "client",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Host",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "instance",
          "stream": "{client=\"$client\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "container",
        "label": "Container",
        "description": "Docker containers. Leave on All to include system logs too; picking containers shows only those.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "container",
          "stream": "{client=\"$client\", instance=~\"$instance\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "program",
        "label": "Process",
        "description": "System processes from the journal (sshd, sudo, systemd, ...). Leave on All to include containers too.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "program",
          "stream": "{client=\"$client\", instance=~\"$instance\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "level",
        "label": "Level",
        "description": "Which log levels to show in the log panel.",
        "type": "custom",
        "query": "Errors : error|crit|critical|fatal|alert|emerg|emergency|panic, Warnings : warn|warning, Info : info|notice, Debug : debug|trace, No level : unknown",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "search",
        "label": "Search",
        "description": "Case-insensitive; regular expressions work.",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Log lines",
      "description": "Every line from the selected hosts and sources in the time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors",
      "description": "Lines logged at error level or worse (error, critical, fatal, alert, emergency, panic). The level is detected from the line itself, so '0 errors found' does not count.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} | detected_level=~\"(?i)(error|crit|critical|fatal|alert|emerg|emergency|panic)\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warnings",
      "description": "Lines logged at warning level.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} | detected_level=~\"(?i)(warn|warning)\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sources with errors",
      "description": "Containers and processes that logged at least one error in the time range. The table below lists them.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (instance, container, program) (count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} | detected_level=~\"(?i)(error|crit|critical|fatal|alert|emerg|emergency|panic)\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Where the errors come from",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Errors and warnings by source",
      "description": "Every container and process that logged an error or warning in the time range, worst first. Click a row's error count to show only that source's logs below.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance, container, program) (count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} | detected_level=~\"(?i)(error|crit|critical|fatal|alert|emerg|emergency|panic)\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance, container, program) (count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} | detected_level=~\"(?i)(warn|warning)\" [$__range]))",
          "refId": "B",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "container": 1,
              "program": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "instance": "Host",
              "container": "Container",
              "program": "Process",
              "Value #A": "Errors",
              "Value #B": "Warnings"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Errors",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "0"
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this source's logs",
                    "url": "/d/em-logs/logs?${__url_time_range}&var-client=${client}&var-instance=${__data.fields.Host}&var-container=${__data.fields.Container}&var-program=${__data.fields.Process}&var-level=All&var-search="
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warnings"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "0"
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Errors",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors over time",
      "description": "Error lines per interval, by source. A source that suddenly appears here is usually the one to look at.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container, program) (count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} | detected_level=~\"(?i)(error|crit|critical|fatal|alert|emerg|emergency|panic)\" [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{container}}{{program}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Logs",
      "description": "Newest first. Narrow it with Host, Container, Process, Level and Search at the top, or by clicking a row in the table above. Scroll down to load older lines.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} | detected_level=~\"(?i)(${level:pipe})\" |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableInfiniteScrolling": true,
        "showControls": true,
        "syntaxHighlighting": true
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Log volume",
      "description": "All lines per interval, by source. Useful for spotting a container that has started logging in a loop.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container, program) (count_over_time({client=\"$client\", instance=~\"$instance\", container=~\"$container\", program=~\"$program\"} |~ \"(?i)$search\" [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{container}}{{program}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
