# GENERATED by scripts/generate.py from clients.yml — do not edit by hand.
#
# Placeholders (__SMTP_*__, __OPS_EMAIL__, __GRAFANA_URL__) are substituted
# at container start by config/alertmanager/render-and-run.sh, so no
# credentials are ever written into this repo.

global:
  resolve_timeout: 5m
  smtp_smarthost: '__SMTP_SMARTHOST__'
  smtp_from: '__SMTP_FROM__'
  smtp_auth_username: '__SMTP_USER__'
  smtp_auth_password_file: /tmp/alertmanager-smtp-password
  smtp_require_tls: __SMTP_REQUIRE_TLS__

templates:
  - /tmp/templates/*.tmpl

route:
  # Anything that does not match a client below still reaches you.
  receiver: ops-fallback
  group_by: ['client', 'alertname']
  # Long enough to batch a cascading failure into one email, short
  # enough that you hear about an outage promptly.
  group_wait: 45s
  group_interval: 5m
  repeat_interval: 12h
  routes:

    # Informational events are recorded but never chase anyone.
    - matchers: ['severity = "info"']
      receiver: ops-only
      group_interval: 30m
      repeat_interval: 24h

    # ── Own infrastructure ──
    - matchers: ['client = "self"']
      receiver: client-self
      routes:
        # Critical issues repeat every 2h until acknowledged.
        - matchers: ['severity = "critical"']
          receiver: client-self
          group_wait: 30s
          repeat_interval: 2h

receivers:

  - name: ops-fallback
    email_configs:
      - to: '__OPS_EMAIL__'
        send_resolved: true
        headers:
          Subject: '{{ template "email.subject" . }}'
        html: '{{ template "email.html" . }}'
        text: '{{ template "email.text" . }}'

  - name: ops-only
    email_configs:
      - to: '__OPS_EMAIL__'
        send_resolved: true
        headers:
          Subject: '{{ template "email.subject" . }}'
        html: '{{ template "email.html" . }}'
        text: '{{ template "email.text" . }}'

  - name: client-self
    email_configs:
      # Own infrastructure
      - to: 'ops@example.com'
        send_resolved: true
        headers:
          Subject: '{{ template "email.subject" . }}'
        html: '{{ template "email.html" . }}'
        text: '{{ template "email.text" . }}'
      # You receive a copy of everything, so you find out first.
      - to: '__OPS_EMAIL__'
        send_resolved: true
        headers:
          Subject: '{{ template "email.subject" . }}'
        html: '{{ template "email.html" . }}'
        text: '{{ template "email.text" . }}'

inhibit_rules:

  # A dead host produces a storm of container and disk alerts. Report
  # the cause, suppress the symptoms — but never suppress HostDown itself.
  - source_matchers: ['alertname = "HostDown"']
    target_matchers: ['severity =~ "warning|critical"', 'alertname != "HostDown"']
    equal: ['client', 'instance']

  # Don't send the warning and the critical for the same thing.
  - source_matchers: ['severity = "critical"']
    target_matchers: ['severity = "warning"']
    equal: ['client', 'instance', 'alertname']

  # A site that is down will also be returning error statuses.
  - source_matchers: ['alertname = "SiteDown"']
    target_matchers: ['alertname =~ "HTTPUnexpectedStatus|SiteSlow|SSLCertInvalid"']
    equal: ['client', 'instance']

  # An imminent expiry makes the 14-day warning redundant.
  - source_matchers: ['alertname = "SSLCertExpiryImminent"']
    target_matchers: ['alertname = "SSLCertExpiringSoon"']
    equal: ['client', 'instance']
